# Database (PostgreSQL). Used by Next.js and scraper.
DATABASE_URL=postgresql://user:pass@localhost:5432/hunter

# Redis for BullMQ scraper worker. Run: brew services start redis
REDIS_URL=redis://localhost:6379

# FlareSolverr — Cloudflare bypass for scraper. Run: docker run -d -p 8191:8191 flaresolverr/flaresolverr:latest
# FLARESOLVERR_URL=http://localhost:8191

# Firecrawl API key (optional fallback for hardest sites)
# FIRECRAWL_API_KEY=fc-your-api-key-here

# Proxy (optional). For PerimeterX/Cloudflare use residential proxies (e.g. BrightData, Oxylabs).
# PROXY_URL=http://user:pass@proxy.example.com:8080
