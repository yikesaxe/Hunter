# Dockerfile.worker — BullMQ scraper worker for cloud deployment (Railway / Fly.io / Render)
#
# Required env vars:
#   DATABASE_URL      postgresql://...
#   REDIS_URL         redis://... or rediss://...
#   SCRAPER_HEADLESS  true
#
# Optional:
#   PROXY_URL         residential proxy (user:pass@host:port)
#   FIRECRAWL_API_KEY Firecrawl last-resort fallback
#   FLARESOLVERR_URL  self-hosted Cloudflare bypass sidecar

FROM node:20-slim

# System packages needed by Chromium + Xvfb for virtual display (bypasses PerimeterX headless detection)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-noto-color-emoji \
    # Core Chromium runtime deps
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./

# Skip rebrowser-playwright's browser download during npm install
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Install all deps (dev included — prisma CLI is a devDep)
RUN npm ci

# Install the exact Chromium build rebrowser-playwright v1.52 expects.
# We use `npx playwright@1.52` (runs transiently via npx) because rebrowser-playwright's
# own CLI has a broken import from the `playwright` package.
RUN npx playwright@1.52 install chromium --with-deps

COPY . .

# Generate Prisma client
RUN npx prisma generate

# Run in headless mode (no display available on Railway servers)
ENV SCRAPER_HEADLESS=true

# On startup: apply any pending migrations, then start the worker
CMD ["sh", "-c", "npx prisma migrate deploy && npx tsx scraper/src/worker/index.ts"]
