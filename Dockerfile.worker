# Dockerfile.worker — BullMQ scraper worker for cloud deployment (Railway / Fly.io / Render)
#
# Required env vars:
#   DATABASE_URL      postgresql://...
#   REDIS_URL         redis://... or rediss://...
#   SCRAPER_HEADLESS  true
#
# Optional:
#   PROXY_URL         residential proxy (user:pass@host:port)
#   FIRECRAWL_API_KEY Firecrawl last-resort fallback
#   FLARESOLVERR_URL  self-hosted Cloudflare bypass sidecar

FROM node:20-slim

# Install system Chromium + all its dependencies.
# We use the OS-packaged Chromium and point rebrowser-playwright to it via env var
# instead of using playwright's browser installer (which breaks on rebrowser-playwright fork).
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# Point rebrowser-playwright (Playwright fork) at the system Chromium binary.
# Also skip the post-install browser download that npm triggers.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

COPY package*.json ./

# Install all deps (dev included — prisma CLI is a devDep, needed for generate)
RUN npm ci

COPY . .

# Generate Prisma client
RUN npx prisma generate

# Run headless — no display available on Railway servers
ENV SCRAPER_HEADLESS=true

# On startup: apply any pending migrations, then start the worker
CMD ["sh", "-c", "npx prisma migrate deploy && npx tsx scraper/src/worker/index.ts"]
