generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Listing {
  id              String   @id @default(uuid())
  source          String
  sourceListingId String?
  url             String
  canonicalUrl    String?

  title        String?
  address      String?
  neighborhood String?
  borough      String?
  city         String   @default("New York")
  state        String   @default("NY")
  zip          String?

  latitude  Float?
  longitude Float?

  price      Int?
  priceDelta Int?   // positive = increase, negative = drop
  beds       Float?
  baths      Float?
  sqft       Int?

  description String?
  amenities   String   @default("[]")
  photos      String   @default("[]")

  brokerName  String?
  brokerPhone String?
  brokerEmail String?

  listedAt DateTime?
  status   String   @default("active")

  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime
  lastScrapedAt DateTime

  contentHash String
  raw         String   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@unique([source, sourceListingId])
  @@index([url])
  @@index([contentHash])
  @@index([source, status])
  @@index([lastSeenAt])
}

model CrawlRun {
  id         String    @id @default(uuid())
  source     String
  startUrl   String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  target     Int       @default(200)
  discovered Int       @default(0)
  scraped    Int       @default(0)
  errors     Int       @default(0)
  stats      String    @default("{}")

  @@index([source])
  @@index([startedAt])
}

// Anonymous device for preferences and events (no auth)
model Device {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  prefs   Preference?
  events  Event[]
  profile DeviceProfile?

  @@index([id])
}

model Preference {
  id          String   @id @default(uuid())
  deviceId    String   @unique
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name        String
  minPrice    Int
  maxPrice    Int
  beds        Json     // number[] e.g. [0,1,2]
  neighborhoods Json   // string[]
  amenities  Json     // string[]
  moveIn      String  // "asap" | "30" | "60" | "90" | "flexible"
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deviceId])
}

model Event {
  id        String   @id @default(uuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type      String   // "impression" | "click" | "save" | "hide" | "outbound"
  metadata  Json?    // e.g. { rank, mode, page }
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([listingId, createdAt])
  @@index([deviceId, listingId, type, createdAt])
}

model DeviceProfile {
  id        String   @id @default(uuid())
  deviceId  String   @unique
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  weights   Json     @default("{}")  // { neighborhood: { Chelsea: 0.7 }, amenity: { Doorman: 0.4 }, borough: {} }
  stats     Json     @default("{}")  // aggregates: avgPriceClicked, bedsDistribution, etc.
  updatedAt DateTime @updatedAt

  @@index([deviceId])
}
